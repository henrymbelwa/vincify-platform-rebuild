# ---------- Public (exposed to the browser) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_APP_URL=http://localhost:3000

# ---------- Server only ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_URL=http://localhost:3000

# AI: Primary provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000

# Optional Alternative AI Providers (OpenAI, Claude, Groq, OpenRouter, Custom)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Encryption key for stored provider secrets (32 hex characters / 16 bytes minimum)
AI_ENCRYPTION_SECRET=your-32-char-random-encryption-key-for-admin-settings

# Bootstrap Administrator Email (Initial setup)
INITIAL_ADMIN_EMAIL=adminvincify@gmail.com

# Successful document analyses allowed per user per day (resets at midnight Africa/Dar_es_Salaam)
DOCUMENT_ANALYSIS_DAILY_LIMIT=3

# SMTP (works with any mailbox: Gmail app password, Outlook, Zoho, cPanel...)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Vincify <you@example.com>"

# Protects the scheduled automation runner (/api/cron/automations)
CRON_SECRET=generate-a-long-random-string

# Build target for Vercel (Nitro preset)
NITRO_PRESET=vercel
