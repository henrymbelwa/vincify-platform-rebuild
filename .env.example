# ---------- Public (exposed to the browser) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_APP_URL=http://localhost:3000

# ---------- Server only ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_URL=http://localhost:3000

# AI provider: "langflow" (primary) or "openai" (any OpenAI-compatible API)
AI_PROVIDER=langflow
# Fall back to the other provider when the primary fails (true/false)
AI_FALLBACK=true
LANGFLOW_URL=https://your-langflow-host
LANGFLOW_FLOW_ID=your-flow-id
LANGFLOW_API_KEY=your-langflow-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-compatible-key
OPENAI_MODEL=gpt-4o-mini

# SMTP (works with any mailbox: Gmail app password, Outlook, Zoho, cPanel...)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Vincify <you@example.com>"

# Protects the scheduled automation runner (/api/cron/automations)
CRON_SECRET=generate-a-long-random-string

# Build target for Vercel (Nitro preset)
NITRO_PRESET=vercel
