# ---------- Public (exposed to the browser) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_APP_URL=http://localhost:3000

# ---------- Server only ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_URL=http://localhost:3000

# AI: native Google Gemini (server only, never exposed to the browser)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
# Successful document analyses allowed per user per day (resets at midnight Africa/Dar_es_Salaam)
DOCUMENT_ANALYSIS_DAILY_LIMIT=3

# SMTP (works with any mailbox: Gmail app password, Outlook, Zoho, cPanel...)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Vincify <you@example.com>"

# Protects the scheduled automation runner (/api/cron/automations)
CRON_SECRET=generate-a-long-random-string

# Build target for Vercel (Nitro preset)
NITRO_PRESET=vercel
